# Document Summarizer Agent - Production Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# =============================================================================
# S3 STORAGE CONFIGURATION
# =============================================================================
S3_BUCKET_NAME=your-s3-bucket-name

# =============================================================================
# MONGODB CONFIGURATION
# =============================================================================
# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=doc_intelligence

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
# Redis connection URL (Redis Cloud recommended)
REDIS_PROVIDER=redis_cloud
REDIS_URL=rediss://:password@redis-xxx.cloud.redislabs.com:12345
# OR use individual settings:
# REDIS_CLOUD_ENDPOINT=redis-xxx.cloud.redislabs.com
# REDIS_CLOUD_PORT=12345
# REDIS_CLOUD_USERNAME=default
# REDIS_CLOUD_PASSWORD=your_password

# =============================================================================
# DATABASE CONFIGURATION (Legacy - PostgreSQL)
# =============================================================================
# PostgreSQL RDS instance (optional, if not using MongoDB)
# DATABASE_URL=postgresql://postgres:your_password@your-rds-endpoint.amazonaws.com:5432/docprocessing

# =============================================================================
# CACHING CONFIGURATION (Legacy - AWS)
# =============================================================================
# DynamoDB table for caching (optional)
# DYNAMODB_CACHE_TABLE=document-summarizer-production-cache

# ElastiCache Redis (optional - for high-performance caching)
# ELASTICACHE_ENDPOINT=your-redis-cluster.cache.amazonaws.com

# =============================================================================

CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}
# TASK QUEUE CONFIGURATION
# =============================================================================
# SQS queue for task processing
SQS_QUEUE_NAME=document-summarizer-production-task-queue
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/document-summarizer-production-task-queue

# Lambda function for task processing
LAMBDA_FUNCTION_NAME=document-summarizer-production-task-processor

# =============================================================================
# AI CONFIGURATION
# =============================================================================
# LLM Provider (gemini, groq, openai, anthropic, aws_bedrock)
LLM_PROVIDER=gemini

# Google Gemini (Primary LLM)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Groq API (Alternative LLM)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# LangChain configuration (optional)
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=DocumentSummarizerAgent

# =============================================================================
# PINECONE VECTOR DATABASE CONFIGURATION
# =============================================================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=document-intelligence
# PINECONE_ENVIRONMENT is deprecated in newer Pinecone versions (v2+)
# If using older Pinecone client, set this to your environment (e.g., us-east-1-aws)

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT secret key (generate with: openssl rand -hex 32)
SECRET_KEY=change_me_generate_a_new_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
# Maximum file size in bytes (10MB)
MAX_FILE_SIZE=10485760

# Allowed file extensions
ALLOWED_EXTENSIONS=[".pdf", ".txt", ".docx"]

# Allowed MIME types
ALLOWED_MIME_TYPES=["application/pdf", "text/plain", "application/vnd.openxmlformats-officedocument.wordprocessingml.document"]

# =============================================================================
# CORS AND SECURITY
# =============================================================================
# Allowed origins for CORS (use specific domains in production)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Allowed hosts
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# =============================================================================
# RATE LIMITING
# =============================================================================
# Maximum uploads per minute per user
UPLOAD_RATE_LIMIT=2
# General requests per minute per user
RATE_LIMIT_PER_MINUTE=20
# Storage backend for rate limits (redis recommended)
RATE_LIMIT_STORAGE_URI=redis://:password@host:port/0

# Maximum processing time in seconds
MAX_PROCESSING_TIME=300

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

